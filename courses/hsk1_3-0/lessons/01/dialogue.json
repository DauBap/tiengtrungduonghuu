{
  "lesson": 1,
  "title": "AI小语，你好",
  "title_pinyin": "AI Xiǎoyǔ, nǐ hǎo",
  "title_vi": "Xin chào AI Tiểu Ngữ",
  "dialogs": [
    {
      "id": "课文一",
      "id_vi": "Bài khóa 1",
      "lines": [
        {
          "speaker": "AI小语",
          "zh": "AI小语，你好！",
          "pinyin": "AI xiǎoyǔ, nǐ hǎo!",
          "vi": "AI Tiểu Ngữ, chào bạn!"
        },
        {
          "speaker": "王一飞",
          "zh": "王老师，你好！",
          "pinyin": "Wáng lǎoshī, nǐ hǎo!",
          "vi": "Cô Vương, chào cô!"
        }
      ]
    },
    {
      "id": "课文二",
      "id_vi": "Bài khóa 2",
      "lines": [
        {
          "speaker": "王一飞",
          "zh": "大家好！",
          "pinyin": "Dàjiā hǎo!",
          "vi": "Chào mọi người!"
        },
        {
          "speaker": "学生们",
          "zh": "老师，您好！",
          "pinyin": "Lǎoshī, nín hǎo!",
          "vi": "Thưa cô, chào cô ạ!"
        },
        {
          "speaker": "小语",
          "zh": "你们好！",
          "pinyin": "Nǐmen hǎo!",
          "vi": "Chào các bạn!"
        },
        {
          "speaker": "学生们",
          "zh": "你好，小语！",
          "pinyin": "Nǐ hǎo, Xiǎoyǔ!",
          "vi": "Chào bạn, Tiểu Ngữ!"
        }
      ]
    },
    {
      "id": "课文三",
      "id_vi": "Bài khóa 3",
      "lines": [
        {
          "speaker": "学生们",
          "zh": "谢谢！",
          "pinyin": "Xièxie!",
          "vi": "Cảm ơn!"
        },
        {
          "speaker": "小语",
          "zh": "不客气！",
          "pinyin": "Bú kèqi!",
          "vi": "Không có gì!"
        },
        {
          "speaker": "王一飞",
          "zh": "同学们，再见！",
          "pinyin": "Tóngxuémen, zàijiàn!",
          "vi": "Các em học sinh, tạm biệt!"
        },
        {
          "speaker": "学生们",
          "zh": "老师，再见！",
          "pinyin": "Lǎoshī, zàijiàn!",
          "vi": "Thưa cô, tạm biệt!"
        }
      ]
    }
  ]
}
